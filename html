        let currentZoom = 1.0;
        let isPanning = false;
        let startPanX = 0, startPanY = 0;
        let panX = 0, panY = 0;

        function ouvrirZoomPlan(src, titre) {
            const modal = document.getElementById('zoom-modal');
            const img = document.getElementById('zoom-modal-img');
            const titleElem = document.getElementById('zoom-modal-title');
            if (!modal || !img) return;

            if (window.TD_IMAGES_DATA) {
                const fname = src.split('/').pop().split('?')[0];
                if (window.TD_IMAGES_DATA[fname]) {
                    src = window.TD_IMAGES_DATA[fname];
                }
            }

            img.src = src;
            if (titleElem) titleElem.innerText = titre || "Visualiseur Haute Définition";
            modal.style.display = 'flex';
            zoomReinitialiser();
        }

        function fermerZoomPlan(e) {
            if (e) e.stopPropagation();
            const modal = document.getElementById('zoom-modal');
            if (modal) modal.style.display = 'none';
        }

        function zoomModifier(delta) {
            currentZoom = Math.max(0.5, Math.min(4.5, currentZoom + delta));
            appliquerZoom();
        }

        function zoomReinitialiser() {
            currentZoom = 1.0;
            panX = 0;
            panY = 0;
            appliquerZoom();
        }

        function appliquerZoom() {
            const img = document.getElementById('zoom-modal-img');
            if (img) {
                img.style.transform = `translate(${panX}px, ${panY}px) scale(${currentZoom})`;
            }
        }

        function zoomStartPan(e) {
            isPanning = true;
            startPanX = e.clientX - panX;
            startPanY = e.clientY - panY;
            e.preventDefault();
        }

        document.addEventListener('mousemove', e => {
            if (!isPanning) return;
            panX = e.clientX - startPanX;
            panY = e.clientY - startPanY;
            appliquerZoom();
        });

        document.addEventListener('mouseup', () => {
            isPanning = false;
        });

