                cls = 'eval-badge eval-vert-fonce';
                palier = 'TRÈS BONNE MAÎTRISE';
            } else if (count === 1) {
                cls = 'eval-badge eval-jaune';
                palier = 'MAÎTRISE FRAGILE';
            }

            if (badge) {
                badge.className = cls;
                badge.innerText = palier;
            }

            // Mise à jour de la compétence organisation correspondante (C2 en MELEC, C4 en MFER)
            const codeOrga = (CONFIG_TD.filiereCode === 'MELEC') ? 'c2' : 'c4';
            const badgeTable = document.getElementById('eval-' + codeOrga + '-palier');
            if (badgeTable) {
                badgeTable.className = cls;
                badgeTable.innerText = palier;
            }
        }

        /* =========================================================================
           11. MOTEUR D'ÉVALUATION ET DE CORRECTION LOCALE DES QUESTIONS
           ========================================================================= */
        function evaluerReponsesQuestions(reponses) {
            let scoreBrut = 0.0;
            const details = {};
            const bareme = CONFIG_TD.baremeQuestions || {};

            for (const [qid, attente] of Object.entries(bareme)) {
                const repBrute = (reponses[qid] || '').trim();
                let pts = 1.0;
                let qType = 'text';

                if (typeof attente === 'object' && attente !== null) {
                    pts = parseFloat(attente.points !== undefined ? attente.points : 1.0);
                    qType = attente.type || 'text';
                }

                let valAttendue = '';
                let altValeurs = [];
                if (typeof attente === 'object' && attente !== null) {
                    valAttendue = attente.valeur !== undefined ? String(attente.valeur) : '';
                    if (Array.isArray(attente.valeurs)) {
                        altValeurs = attente.valeurs.map(v => String(v).trim().toLowerCase());
                    }
                } else {
                    valAttendue = String(attente);
                }

                const repNorm = repBrute.toLowerCase();
                const attNorm = valAttendue.trim().toLowerCase();
                let isOk = false;

                if (repNorm.length > 0) {
                    if (repNorm === attNorm) {
                        isOk = true;
                    } else if (altValeurs.includes(repNorm)) {
                        isOk = true;
                    } else if (qType === 'number') {
                        const repDigits = repNorm.replace(/[^0-9,\.\-+]/g, '').replace(',', '.');
                        const attDigits = attNorm.replace(/[^0-9,\.\-+]/g, '').replace(',', '.');
                        const numRep = parseFloat(repDigits);
                        const numAtt = parseFloat(attDigits);
                        if (!isNaN(numRep) && !isNaN(numAtt)) {
                            if (Math.abs(numRep - numAtt) < 0.05) {
                                isOk = true;
                            } else if (numAtt > 1 && Math.abs(numRep * 100 - numAtt) < 0.05) {
                                isOk = true;
                            } else if (numRep > 1 && Math.abs(numRep - numAtt * 100) < 0.05) {
                                isOk = true;
                            }
                        }
                    } else if (qType === 'text') {
                        const cleanRep = repNorm.replace(/[\s\-_]/g, '');
                        const cleanAtt = attNorm.replace(/[\s\-_]/g, '');
                        if (cleanRep === cleanAtt) {
                            isOk = true;
                        } else if (altValeurs.some(v => v.replace(/[\s\-_]/g, '') === cleanRep)) {
                            isOk = true;
                        }
                    }
                }

                const ptsAttrib = isOk ? pts : 0.0;
                scoreBrut += ptsAttrib;
                details[qid] = {
                    points: ptsAttrib,
                    statut: isOk ? 'correct' : 'incorrect',
                    commentaire: isOk ? 'Exact' : ('Attendu : ' + valAttendue)
                };
            }

            const denom = CONFIG_TD.totalPointsBruts || 24.0;
            const note20 = (scoreBrut / denom) * 20.0;
            return { scoreBrut, note20, details, totalBrut: denom };
        }

        function insererFeedbackCorrection(elem, qid, feedbackDiv) {
            const ancien = document.querySelector(`.correction-feedback[data-corr-qid="${qid}"]`);
            if (ancien) ancien.remove();

            const card = elem.closest('.question-card');
            if (card) {
                card.appendChild(feedbackDiv);
            } else {
                elem.insertAdjacentElement('afterend', feedbackDiv);
            }
        }

        function appliquerCorrectionDossier(detailsQuestions) {
            const bareme = CONFIG_TD.baremeQuestions || {};
            for (const [qid, res] of Object.entries(detailsQuestions)) {
                const elem = document.querySelector(`[data-qid="${qid}"]`);
                if (!elem) continue;

                const attente = bareme[qid] || {};
                const ptsMax = parseFloat(attente.points !== undefined ? attente.points : 1.0);
                const valAttendue = attente.valeur !== undefined ? attente.valeur : (attente.reponse || "");

                elem.classList.remove('input-correct', 'input-partial', 'input-wrong');

                const feedback = document.createElement('div');
                feedback.className = 'correction-feedback';
                feedback.setAttribute('data-corr-qid', qid);

                const qLabel = elem.getAttribute('placeholder') || elem.getAttribute('data-label') || '';
                let labelPrefix = '';
                if (qLabel) {
                    labelPrefix = `<strong>[${qLabel.replace(' (en cm)', '')}]</strong> `;
                }

                if (res.statut === 'correct') {
                    elem.classList.add('input-correct');
                    feedback.className += ' corr-correct';
                    feedback.innerHTML = `${labelPrefix}<strong>Exact (+${ptsMax.toFixed(2)} pt) :</strong> ${valAttendue}`;
                } else if (res.statut === 'partiel') {
                    elem.classList.add('input-partial');
                    feedback.className += ' corr-partial';
                    feedback.innerHTML = `${labelPrefix}<strong>Partiel (+${res.points.toFixed(2)}/${ptsMax.toFixed(2)} pt) :</strong> Attendu : <em>${valAttendue}</em>. ${res.commentaire || ''}`;
                } else {
                    elem.classList.add('input-wrong');
                    feedback.className += ' corr-wrong';
                    feedback.innerHTML = `${labelPrefix}<strong>Incorrect (0.00/${ptsMax.toFixed(2)} pt) :</strong> Réponse attendue : <strong>${valAttendue}</strong>`;
                }

                insererFeedbackCorrection(elem, qid, feedback);
                elem.setAttribute('readonly', 'true');
                if (elem.tagName === 'SELECT') {
                    elem.style.pointerEvents = 'none';
                }
            }
        }

        /* =========================================================================
           12. GÉNÉRATION PDF A4 HAUTE FIDÉLITÉ (HTML2CANVAS & JSPDF)
           ========================================================================= */
        async function construireDossierCompletPDF() {
            try {
                const jsPDFClass = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
                if (typeof html2canvas === 'undefined' || !jsPDFClass) {
                    console.warn("Librairies PDF html2canvas ou jsPDF non chargées.");
                    return null;
                }

                const pdf = new jsPDFClass({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'a4',
                    compress: true
                });

                const wasSingleMode = document.body.classList.contains('mode-single');
                if (wasSingleMode) document.body.classList.remove('mode-single');

                if (window.TD_IMAGES_DATA) {
                    document.querySelectorAll('img').forEach(img => {
                        const src = img.getAttribute('src');
                        if (src) {
                            const filename = src.split('/').pop().split('?')[0];
                            if (window.TD_IMAGES_DATA[filename]) {
                                img.src = window.TD_IMAGES_DATA[filename];
                            }
                        }
                    });
                }

                for (let i = 0; i < TOUTES_LES_PAGES.length; i++) {
                    const pageElem = document.getElementById(TOUTES_LES_PAGES[i]);
                    if (!pageElem) continue;

                    const canvas = await html2canvas(pageElem, {
                        scale: 1.8,
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: '#ffffff',
                        logging: false
                    });

                    const imgData = canvas.toDataURL('image/jpeg', 0.88);
                    if (i > 0) pdf.addPage('a4', 'portrait');
                    pdf.addImage(imgData, 'JPEG', 0, 0, 210, 297);
                }

                if (wasSingleMode) document.body.classList.add('mode-single');
                return pdf;
            } catch (err) {
                console.error("Erreur génération PDF :", err);
                return null;
            }
        }

        async function exporterDossierPDF() {
            const btnDock = document.getElementById('btn-dock-pdf');
            const originalText = btnDock ? btnDock.innerText : 'Enregistrer PDF';
            if (btnDock) {
                btnDock.innerText = 'Génération du PDF...';
                btnDock.disabled = true;
            }

            try {
                const pdf = await construireDossierCompletPDF();
                if (!pdf) throw new Error("Échec d'initialisation du moteur PDF.");
                const nomFichier = construireNomFichierPDF();
                pdf.save(nomFichier);
            } catch (err) {
                alert("Une erreur est survenue lors de la création du PDF : " + err.message);
            } finally {
                if (btnDock) {
                    btnDock.innerText = originalText;
                    btnDock.disabled = false;
                }
            }
        }

        async function telechargerPDFSecoursLocal() {
            const btnSecoursBox = document.getElementById('btn-secours-prof-box');
            if (btnSecoursBox) btnSecoursBox.innerText = "Génération PDF...";

            const reponses = {};
            document.querySelectorAll('[data-qid]').forEach(elem => {
                reponses[elem.getAttribute('data-qid')] = elem.value.trim();
            });

            evaluerLocalementSecours(reponses);

            try {
                await exporterDossierPDF();
                if (btnSecoursBox) {
                    btnSecoursBox.innerText = "PDF téléchargé";
                    btnSecoursBox.style.background = "#16a34a";
                }
            } catch (err) {
                alert("Erreur lors de l'export local : " + err.message);
                if (btnSecoursBox) btnSecoursBox.innerText = "Réessayer PDF";
            }
        }

        /* =========================================================================
           13. VALIDATION PROFESSEUR (PIN 7049 & ÉVALUATION)
           ========================================================================= */
        async function validerTD() {
            const inputCode = document.getElementById('prof-code');
            const errorElem = document.getElementById('prof-error-msg');
            const btnValider = document.getElementById('btn-valider-td');
            const codeSaisi = inputCode ? inputCode.value.trim() : '';

            if (errorElem) errorElem.style.display = 'none';

            if (!verifierChampsIdentite()) {
                if (errorElem) {
                    errorElem.innerHTML = "<strong>Identification obligatoire !</strong> Veuillez renseigner le nom, prénom et classe en Page 1.";
                    errorElem.style.display = 'block';
                }
                naviguerVersPage('page-1-garde');
                return;
            }

            if (codeSaisi !== '7049') {
                if (errorElem) {
                    errorElem.innerText = "Code secret incorrect ! Appel de l'enseignant requis.";
                    errorElem.style.display = 'block';
                }
                if (inputCode) inputCode.value = '';
                return;
            }

            const reponses = {};
            document.querySelectorAll('[data-qid]').forEach(elem => {
                reponses[elem.getAttribute('data-qid')] = elem.value.trim();
            });

            evaluerLocalementSecours(reponses);

            if (btnValider) btnValider.disabled = true;
            if (inputCode) inputCode.disabled = true;

            const validatedBox = document.getElementById('prof-validated-box');
            if (validatedBox) validatedBox.style.display = 'block';

            const filenameDisplay = document.getElementById('saved-filename-display');
            if (filenameDisplay) filenameDisplay.innerText = construireNomFichierPDF();

            const statusBadge = document.getElementById('dock-status-badge');
            if (statusBadge) {
                statusBadge.innerText = 'VALIDÉ';
                statusBadge.className = 'dock-status-badge status-validated';
                statusBadge.style.background = '#16a34a';
            }

            const btnDockPdf = document.getElementById('btn-dock-pdf');
            if (btnDockPdf) {
                btnDockPdf.disabled = false;
                btnDockPdf.style.opacity = '1';
                btnDockPdf.style.cursor = 'pointer';
            }

            const btnSecoursProf = document.getElementById('btn-secours-prof-box');
            if (btnSecoursProf) btnSecoursProf.style.display = 'inline-block';
        }

        /* =========================================================================
           14. CALCUL DES COMPÉTENCES & PALIERS ÉDUSCOL
           ========================================================================= */
        function determinerClassePalier(palierStr) {
            const str = (palierStr || '').toUpperCase();
            if (str.includes('TRÈS BONNE') || str.includes('TRES BONNE')) return 'eval-vert-fonce';
            if (str.includes('SATISFAISANTE')) return 'eval-vert-clair';
            if (str.includes('FRAGILE')) return 'eval-jaune';
            return 'eval-rouge';
        }

        function palierDepuisNote(note) {
            if (note >= 17.0) return "TRÈS BONNE MAÎTRISE";
            if (note > 11.0) return "MAÎTRISE SATISFAISANTE";
            if (note > 4.0) return "MAÎTRISE FRAGILE";
            return "MAÎTRISE INSUFFISANTE";
        }

        function mettreAJourBadgesCompetences(competencesObj) {
            if (!competencesObj) return;
            for (const [code, palier] of Object.entries(competencesObj)) {
                const badgeElem = document.getElementById('eval-' + code.toLowerCase() + '-palier');
                if (badgeElem) {
                    badgeElem.className = 'eval-badge ' + determinerClassePalier(palier);
                    badgeElem.innerText = String(palier).toUpperCase();
                }
            }
        }

        function calculerCompetencesLocales(noteFinale) {
            const c1Checked = document.getElementById('check-c2-classeur')?.checked;
            const c2Checked = document.getElementById('check-c2-stylo')?.checked;
            const countC2 = (c1Checked ? 1 : 0) + (c2Checked ? 1 : 0);
            const palierC2 = countC2 === 2 ? 'TRÈS BONNE MAÎTRISE' : (countC2 === 1 ? 'MAÎTRISE FRAGILE' : 'MAÎTRISE INSUFFISANTE');
            const palierNote = palierDepuisNote(noteFinale);

            const compObj = {};
            if (Array.isArray(CONFIG_TD.competences)) {
                CONFIG_TD.competences.forEach(c => {
                    if (c.mode === 'cases_prof' || c.code === 'C4' || (CONFIG_TD.filiereCode === 'MELEC' && c.code === 'C2')) {
                        compObj[c.code] = palierC2;
                    } else {
                        compObj[c.code] = palierNote;
                    }
                });
            }
            return { compObj, palierC2, palierNote };
        }

        function evaluerLocalementSecours(reponses) {
            const evalResult = evaluerReponsesQuestions(reponses);
            appliquerCorrectionDossier(evalResult.details);

            const scoreBrut = evalResult.scoreBrut;
            const denom = evalResult.totalBrut;
            const note20Brute = evalResult.note20;
            const nbPayants = Math.max(0, indicesDebloquesSet.size - CONFIG_TD.indicesGratuits);
            const penalite = nbPayants * CONFIG_TD.penaliteParIndice;
            const noteFinale = Math.max(0.0, Math.min(20.0, Math.round((note20Brute - penalite) * 10) / 10));

            const { compObj, palierNote } = calculerCompetencesLocales(noteFinale);

            const noteElem = document.getElementById('global-score-converted');
            if (noteElem) noteElem.innerText = noteFinale.toFixed(1) + " / 20";

            const rawElem = document.getElementById('global-score-raw');
            if (rawElem) rawElem.innerText = scoreBrut.toFixed(1) + " / " + denom.toFixed(1) + " pts";

            const statusTextElem = document.getElementById('prof-eval-status-text');
            if (statusTextElem) {
                statusTextElem.innerHTML = "<span style='color: #15803d; font-weight: bold;'>Dossier validé et certifié conforme</span>";
            }

            mettreAJourBadgesCompetences(compObj);
            mettreAJourC2();
            mettreAJourAffichageIndices();
        }

        /* =========================================================================
           15. INITIALISATION AU DOMCONTENTLOADED
           ========================================================================= */
        document.addEventListener('DOMContentLoaded', () => {
            const titreOffP1 = document.getElementById('header-titre-officiel');
            if (titreOffP1 && CONFIG_TD.titreOfficiel) titreOffP1.innerText = CONFIG_TD.titreOfficiel;

            const titreOffP2 = document.getElementById('header-titre-officiel-p2');
            if (titreOffP2 && CONFIG_TD.titreOfficiel) titreOffP2.innerText = CONFIG_TD.titreOfficiel;

            const titreOffP3 = document.getElementById('header-titre-officiel-p3');
            if (titreOffP3 && CONFIG_TD.titreOfficiel) titreOffP3.innerText = CONFIG_TD.titreOfficiel;

            // Remplacement des images locales par Base64 si disponibles
            if (window.TD_IMAGES_DATA) {
                document.querySelectorAll('img').forEach(img => {
                    const src = img.getAttribute('src');
                    if (src) {
                        const fname = src.split('/').pop().split('?')[0];
                        if (window.TD_IMAGES_DATA[fname]) {
                            img.src = window.TD_IMAGES_DATA[fname];
                        }
                    }
                });
            }

            // Zoom molette sur visualiseur
            const modalZoom = document.getElementById('zoom-modal');
            if (modalZoom) {
                modalZoom.addEventListener('wheel', (e) => {
                    const delta = e.deltaY < 0 ? 0.15 : -0.15;
                    zoomModifier(delta);
                    e.preventDefault();
                }, { passive: false });
            }

            // Initialisation de l'identité et adaptation de la filière (par défaut 1MELEC1)
            mettreAJourIdentite();
            onUserAnswerChange(null);
            mettreAJourC2();
        });
    </script>
