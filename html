        document.addEventListener('mousemove', e => {
            if (!loupeActive) return;
            const canvas = document.getElementById('loupe-canvas');
            if (!canvas) return;

            const frame = e.target.closest('.plan-frame');
            if (!frame) {
                canvas.style.display = 'none';
                return;
            }

            const img = frame.querySelector('img');
            if (!img || !img.complete || img.naturalWidth === 0) {
                canvas.style.display = 'none';
                return;
            }

            canvas.style.display = 'block';
            canvas.style.left = e.clientX + 'px';
            canvas.style.top = e.clientY + 'px';

            const ctx = canvas.getContext('2d');
            const rect = img.getBoundingClientRect();
            const relX = (e.clientX - rect.left) / rect.width;
            const relY = (e.clientY - rect.top) / rect.height;

            if (relX < 0 || relX > 1 || relY < 0 || relY > 1) {
                canvas.style.display = 'none';
                return;
            }

            const natX = relX * img.naturalWidth;
            const natY = relY * img.naturalHeight;
            const zoomLevel = 2.5;
            const sW = canvas.width / zoomLevel;
            const sH = canvas.height / zoomLevel;
            const sX = Math.max(0, Math.min(img.naturalWidth - sW, natX - sW / 2));
            const sY = Math.max(0, Math.min(img.naturalHeight - sH, natY - sH / 2));

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, sX, sY, sW, sH, 0, 0, canvas.width, canvas.height);
        });

