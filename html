        function construireNomFichierPDF() {
            const classe = document.getElementById('student-classe').value.trim() || 'CLASSE';
            const nom1 = document.getElementById('student-nom').value.trim().toUpperCase() || 'ELEVE1';
            const prenom1 = document.getElementById('student-prenom').value.trim() || 'Prenom1';
            const selectGroupe = document.getElementById('student-groupe');
            const sansGroupe = (classe === '1MELFER MELEC' || classe === '1MELFER MFER');
            const groupe = (!sansGroupe && selectGroupe) ? selectGroupe.value.replace(/\s+/g, '') : '';

            let base = classe;
            if (groupe) base += '_' + groupe;
            base += '_' + nom1 + '_' + prenom1;

            if (isDuoMode) {
                const nom2 = document.getElementById('student-nom2').value.trim().toUpperCase() || 'ELEVE2';
                const prenom2 = document.getElementById('student-prenom2').value.trim() || 'Prenom2';
                base += '_ET_' + nom2 + '_' + prenom2;
            }

            base += '_' + CONFIG_TD.codeTD;
            const dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
            base += '_' + dateStr + '.pdf';
            return base.replace(/[^a-zA-Z0-9_\-\.]/g, '_');
        }

